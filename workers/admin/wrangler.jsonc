{
	"$schema": "../../node_modules/wrangler/config-schema.json",
	"name": "newsroll-admin",
	"main": "index.mjs",
	"compatibility_date": "2026-03-09",
	"compatibility_flags": [
		"nodejs_compat_v2"
	],
	// Required secrets (wrangler secret put):
	// - SUPABASE_SECRET_KEY
	// - ADMIN_USERNAME
	// - ADMIN_PASSWORD
	// - OPENAI_API_KEY
	// - FAL_API_KEY
	// - CLOUDFLARE_API_TOKEN
	// - SHAPED_API_KEY
	"vars": {
		"APP_NAME": "NewsRoll Admin",
		"ENVIRONMENT": "production",
		"CLOUDFLARE_ACCOUNT_ID": "ccbc9926d08a298aee2a4f0cffcfc4a3",
		"SUPABASE_URL": "https://snazihvdznshybaogwrx.supabase.co"
	},
	"routes": [
		{
			"pattern": "admin.newsroll.app",
			"custom_domain": true
		}
	],
	"r2_buckets": [
		{
			"binding": "MEDIA_BUCKET",
			"bucket_name": "newsroll-media-staging"
		}
	],
	"assets": {
		"directory": "../../../NewsRollAdmin/dist",
		"binding": "ASSETS",
		"not_found_handling": "single-page-application"
	},
	"observability": {
		"enabled": true,
		"head_sampling_rate": 1,
		"logs": {
			"enabled": true
		}
	},
	"env": {
		"staging": {
			"name": "newsroll-admin-staging",
			// Required secrets for staging match production
			"vars": {
				"APP_NAME": "NewsRoll Admin",
				"ENVIRONMENT": "staging",
				"CLOUDFLARE_ACCOUNT_ID": "ccbc9926d08a298aee2a4f0cffcfc4a3",
				"SUPABASE_URL": "https://snazihvdznshybaogwrx.supabase.co"
			},
			"routes": [
				{
					"pattern": "admin-staging.newsroll.app",
					"custom_domain": true
				}
			],
			"r2_buckets": [
				{
					"binding": "MEDIA_BUCKET",
					"bucket_name": "newsroll-media-staging"
				}
			],
			"assets": {
				"directory": "../../../NewsRollAdmin/dist",
				"binding": "ASSETS",
				"not_found_handling": "single-page-application"
			},
			"observability": {
				"enabled": true,
				"head_sampling_rate": 1,
				"logs": {
					"enabled": true
				}
			}
		}
	}
}
