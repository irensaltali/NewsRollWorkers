{
	"$schema": "../../node_modules/wrangler/config-schema.json",
	"name": "newsroll-processor",
	"main": "index.mjs",
	"compatibility_date": "2026-03-09",
	"compatibility_flags": [
		"nodejs_compat_v2"
	],
	// Required secrets (wrangler secret put):
	// - SUPABASE_SECRET_KEY
	// - OPENAI_API_KEY
	// - FAL_API_KEY
	// - CLOUDFLARE_API_TOKEN
	// - SHAPED_API_KEY
	// - FIRECRAWL_API_KEYS
	"migrations": [
		{
			"tag": "v1-global-visual-feed-coordinator",
			"new_sqlite_classes": [
				"GlobalVisualFeedCoordinator"
			]
		}
	],
	"vars": {
		"ENVIRONMENT": "production",
		"CLOUDFLARE_ACCOUNT_ID": "ccbc9926d08a298aee2a4f0cffcfc4a3",
		"PUBLIC_API_BASE_URL": "https://api.newsroll.app",
		"PUBLIC_MEDIA_BASE_URL": "https://media.newsroll.app",
		"SUPABASE_URL": "https://snazihvdznshybaogwrx.supabase.co",
		"MEDIA_FALAI_LIMIT": "50"
	},
	"durable_objects": {
		"bindings": [
			{
				"name": "GLOBAL_VISUAL_FEED_COORDINATOR",
				"class_name": "GlobalVisualFeedCoordinator"
			}
		]
	},
	"kv_namespaces": [
		{
			"binding": "VISUAL_FEED_CACHE",
			"id": "4cd0d14a54554f23a9afd0006b23c2c3"
		}
	],
	"r2_buckets": [
		{
			"binding": "MEDIA_BUCKET",
			"bucket_name": "newsroll-media"
		}
	],
	"queues": {
		"producers": [
			{
				"binding": "MEDIA_QUEUE",
				"queue": "newsroll-media"
			}
		],
		"consumers": [
			{
				"queue": "newsroll-media",
				"max_batch_size": 5,
				"max_batch_timeout": 5
			}
		]
	},
	"observability": {
		"enabled": true,
		"head_sampling_rate": 1
	}
}