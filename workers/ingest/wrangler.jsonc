{
	"$schema": "../../node_modules/wrangler/config-schema.json",
	"name": "newsroll-ingest",
	"main": "index.mjs",
	"compatibility_date": "2026-03-09",
	"compatibility_flags": [
		"nodejs_compat_v2"
	],
	// Required secrets (wrangler secret put):
	// - SUPABASE_SECRET_KEY
	// - CLOUDFLARE_API_TOKEN
	// - FIRECRAWL_API_KEYS
	"vars": {
		"ENVIRONMENT": "production",
		"CLOUDFLARE_ACCOUNT_ID": "ccbc9926d08a298aee2a4f0cffcfc4a3",
		"MEDIA_DAILY_LIMIT": "50",
		"MEDIA_PER_RUN_LIMIT": "5",
		"SUPABASE_URL": "https://snazihvdznshybaogwrx.supabase.co"
	},
	"queues": {
		"producers": [
			{
				"binding": "MEDIA_QUEUE",
				"queue": "newsroll-media"
			}
		]
	},
	"triggers": {
		"crons": [
			"*/5 * * * *"
		]
	},
	"observability": {
		"enabled": true,
		"head_sampling_rate": 1
	}
}
