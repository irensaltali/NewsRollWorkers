{
	"$schema": "../../node_modules/wrangler/config-schema.json",
	"name": "newsroll-workers",
	"main": "index.mjs",
	"compatibility_date": "2026-03-09",
	"compatibility_flags": [
		"nodejs_compat_v2"
	],
	// Required secrets (wrangler secret put):
	// - SUPABASE_SECRET_KEY
	// - SUPABASE_JWT_SECRET
	// - OPENAI_API_KEY
	// - REVENUECAT_SECRET_KEY
	// - CLOUDFLARE_API_TOKEN
	// - SHAPED_API_KEY
	"vars": {
		"APP_NAME": "NewsRoll",
		"ENVIRONMENT": "production",
		"CLOUDFLARE_ACCOUNT_ID": "ccbc9926d08a298aee2a4f0cffcfc4a3",
		"EVENT_ANALYTICS_DATASET": "newsroll_user_events",
		"PUBLIC_BASE_URL": "https://api.newsroll.app",
		"PUBLIC_API_BASE_URL": "https://api.newsroll.app",
			"PUBLIC_MEDIA_BASE_URL": "https://media.newsroll.app",
		"REVENUECAT_APP_ID": "app8fd0f68a2b",
		"REVENUECAT_PROJECT_ID": "proj503ccfa0",
		"SHAPED_ENGINE_NAME": "newsroll_visual_v1",
		"SHAPED_ITEMS_TABLE": "newsroll_items",
		"SHAPED_INTERACTIONS_TABLE": "newsroll_interactions",
		"SUPABASE_URL": "https://snazihvdznshybaogwrx.supabase.co"
	},
	"routes": [
		{
			"pattern": "api.newsroll.app",
			"custom_domain": true
		}
	],
	"kv_namespaces": [
			{
				"binding": "VISUAL_FEED_CACHE",
				"id": "4cd0d14a54554f23a9afd0006b23c2c3"
			}
	],
	"analytics_engine_datasets": [
		{
			"binding": "EVENT_ANALYTICS",
			"dataset": "newsroll_user_events"
		}
	],
	"observability": {
		"enabled": true,
		"head_sampling_rate": 1,
		"logs": {
			"enabled": true
		}
	},
	// ── Staging environment ─────────────────────────────────────────────
	"env": {
		"staging": {
			"name": "newsroll-workers-staging",
			// Required secrets for staging match production
			"vars": {
				"APP_NAME": "NewsRoll",
				"ENVIRONMENT": "staging",
				"CLOUDFLARE_ACCOUNT_ID": "ccbc9926d08a298aee2a4f0cffcfc4a3",
				"EVENT_ANALYTICS_DATASET": "newsroll_user_events",
				"PUBLIC_BASE_URL": "https://api-staging.newsroll.app",
				"PUBLIC_API_BASE_URL": "https://api-staging.newsroll.app",
					"PUBLIC_MEDIA_BASE_URL": "https://media.newsroll.app",
				"REVENUECAT_APP_ID": "app8fd0f68a2b",
				"REVENUECAT_PROJECT_ID": "proj503ccfa0",
				"SHAPED_ENGINE_NAME": "newsroll_visual_v1",
				"SHAPED_ITEMS_TABLE": "newsroll_items",
				"SHAPED_INTERACTIONS_TABLE": "newsroll_interactions",
				"SUPABASE_URL": "https://snazihvdznshybaogwrx.supabase.co"
			},
			"routes": [
				{
					"pattern": "api-staging.newsroll.app",
					"custom_domain": true
				}
			],
			"kv_namespaces": [
					{
						"binding": "VISUAL_FEED_CACHE",
						"id": "4cd0d14a54554f23a9afd0006b23c2c3"
					}
			],
			"analytics_engine_datasets": [
				{
					"binding": "EVENT_ANALYTICS",
					"dataset": "newsroll_user_events"
				}
			],
			"observability": {
				"enabled": true,
				"head_sampling_rate": 1,
				"logs": {
					"enabled": true
				}
			}
		}
	}
}
